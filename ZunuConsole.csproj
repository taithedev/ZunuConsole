<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ZunuConsole</AssemblyName>
    <RootNamespace>ZunuConsole</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GorillaTagDir Condition="'$(GorillaTagDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GorillaTagDir>
    <GameManaged>$(GorillaTagDir)\Gorilla Tag_Data\Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(GorillaTagDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(GameManaged)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(GameManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(GameManaged)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(GameManaged)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GorillaTagDir)\BepInEx\core\BepInEx.dll')" Text="BepInEx.dll not found. Install BepInEx 5 and set /p:GorillaTagDir=YOUR_GORILLA_TAG_FOLDER." />
    <Error Condition="!Exists('$(GameManaged)\UnityEngine.CoreModule.dll')" Text="Gorilla Tag Unity files not found. Set /p:GorillaTagDir=YOUR_GORILLA_TAG_FOLDER." />
    <Error Condition="!Exists('$(GameManaged)\UnityEngine.IMGUIModule.dll')" Text="Unity IMGUI module missing. Check GorillaTagDir." />
    <Error Condition="!Exists('$(GameManaged)\UnityEngine.JSONSerializeModule.dll')" Text="Neon cloud JSON module missing. Check GorillaTagDir." />
    <Error Condition="!Exists('$(GameManaged)\UnityEngine.UnityWebRequestModule.dll')" Text="Neon cloud HTTP module missing. Check GorillaTagDir." />
    <Error Condition="!Exists('$(GameManaged)\UnityEngine.ScreenCaptureModule.dll')" Text="Unity screenshot module missing (UnityEngine.ScreenCaptureModule.dll). Check GorillaTagDir and your installed game files." />
  </Target>
</Project>
